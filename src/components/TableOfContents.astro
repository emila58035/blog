---
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
}

// 只收 h2 / h3：h1 是文章标题本身，h4 及以下在小屏上太碎
const { headings } = Astro.props;
const items = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{
  items.length > 1 && (
    <details class="toc" data-toc>
      <summary>目录</summary>
      <ol>
        {items.map((h) => (
          <li class={`toc-depth-${h.depth}`}>
            <a href={`#${h.slug}`}>{h.text}</a>
          </li>
        ))}
      </ol>
    </details>
  )
}

<script>
  // 宽屏默认摊开、窄屏默认收起。
  // 客户端导航时模块脚本不会重跑，所以挂 astro:page-load（首屏也会触发一次）。
  const applyTocDefault = () => {
    const expand = window.matchMedia('(min-width: 48rem)').matches;
    for (const el of document.querySelectorAll<HTMLDetailsElement>('[data-toc]')) {
      el.open = expand;
    }
  };
  document.addEventListener('astro:page-load', applyTocDefault);
</script>

<style>
  .toc {
    margin: 0 0 2rem;
    padding: 0.85rem 1.1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-elevated);
    font-size: 0.9rem;
  }

  .toc summary {
    cursor: pointer;
    font-weight: 550;
    color: var(--text);
    /* 去掉 Safari 的三角，自己画一个 */
    list-style: none;
  }

  .toc summary::-webkit-details-marker {
    display: none;
  }

  .toc summary::after {
    content: '';
    display: inline-block;
    width: 0.45rem;
    height: 0.45rem;
    margin-left: 0.5rem;
    border-right: 1.5px solid var(--text-muted);
    border-bottom: 1.5px solid var(--text-muted);
    transform: translateY(-0.15rem) rotate(45deg);
  }

  .toc[open] summary::after {
    transform: translateY(-0.05rem) rotate(225deg);
  }

  .toc ol {
    list-style: none;
    margin: 0.7rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.35rem;
  }

  .toc li {
    line-height: 1.5;
  }

  .toc-depth-3 {
    padding-left: 1rem;
    font-size: 0.875rem;
  }

  .toc a {
    color: var(--text-muted);
    text-decoration: none;
  }

  .toc a:hover {
    color: var(--accent);
    text-decoration: underline;
  }

  /* 收起时不留底部空白 */
  .toc:not([open]) {
    padding-bottom: 0.85rem;
  }
</style>

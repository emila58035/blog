---
import { href } from '../utils/url';

const links = [
  { path: '', label: '首页' },
  { path: 'archive/', label: '归档' },
  { path: 'about/', label: '关于' },
];

const current = Astro.url.pathname;
const isActive = (path: string) => {
  const target = href(path);
  if (path === '') return current === target;
  return current.startsWith(target);
};
---

<header class="site-header" data-header>
  <a class="brand" href={href()}>Emila</a>

  <nav>
    {
      links.map((link) => (
        <a href={href(link.path)} aria-current={isActive(link.path) ? 'page' : undefined}>
          {link.label}
        </a>
      ))
    }
  </nav>

  <button id="theme-toggle" type="button" aria-label="切换深浅色主题" title="切换主题">
    <svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true">
      <circle cx="12" cy="12" r="4.2"></circle>
      <path d="M12 2v3M12 19v3M2 12h3M19 12h3M4.9 4.9l2.1 2.1M17 17l2.1 2.1M19.1 4.9L17 7M7 17l-2.1 2.1"></path>
    </svg>
    <svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M20 14.5A8.2 8.2 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5z"></path>
    </svg>
  </button>
</header>

<script>
  // 事件委托挂在 document 上：客户端导航会把按钮换成新节点，
  // 直接绑在按钮上的监听不会跟着活过来。
  document.addEventListener('click', (event) => {
    if (!(event.target instanceof Element) || !event.target.closest('#theme-toggle')) return;

    const root = document.documentElement;
    const explicit = root.dataset.theme;
    const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;

    root.dataset.theme = (explicit ? explicit === 'dark' : prefersDark) ? 'light' : 'dark';
    try {
      localStorage.setItem('theme', root.dataset.theme);
    } catch {
      /* 隐私模式下 localStorage 可能不可用，忽略即可 */
    }
  });

  // 顶栏压在首页 Hero 上时改成透明 + 白字，滚过 Hero 再换回毛玻璃。
  // 模块脚本客户端导航后不会重跑，所以每次换页都在 astro:page-load 里重新来一遍；
  // 同理，header 元素每次都是新节点，不能在模块顶层抓一次就一直用。
  let observer: IntersectionObserver | undefined;

  const syncHeader = () => {
    const header = document.querySelector<HTMLElement>('[data-header]');
    if (!header) return;

    document.documentElement.style.setProperty('--header-h', header.offsetHeight + 'px');

    observer?.disconnect();
    const hero = document.querySelector('[data-hero]');
    if (!hero) {
      header.removeAttribute('data-over-hero');
      return;
    }

    // 先按"压着 Hero"渲染，滚动位置交给 observer 修正
    header.setAttribute('data-over-hero', 'true');
    observer = new IntersectionObserver(([entry]) => {
      header.toggleAttribute('data-over-hero', entry.isIntersecting);
    });
    observer.observe(hero);
  };

  document.addEventListener('astro:page-load', syncHeader);
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding-block: 0.85rem;
    background: var(--bg-overlay);
    backdrop-filter: saturate(180%) blur(12px);
    border-bottom: 1px solid var(--border);
    transition:
      background-color var(--transition),
      border-color var(--transition);
  }

  /* 压在首页 Hero 上：透明底 + 白字，去掉毛玻璃和分隔线 */
  .site-header[data-over-hero='true'] {
    background: transparent;
    backdrop-filter: none;
    border-bottom-color: transparent;
  }

  .site-header[data-over-hero='true'] .brand {
    color: #fff;
  }

  .site-header[data-over-hero='true'] nav a {
    color: rgb(255 255 255 / 78%);
  }

  .site-header[data-over-hero='true'] nav a:hover {
    color: #fff;
  }

  .site-header[data-over-hero='true'] nav a[aria-current='page'] {
    color: #fff;
    border-bottom-color: rgb(255 255 255 / 85%);
  }

  .site-header[data-over-hero='true'] #theme-toggle {
    background: rgb(0 0 0 / 25%);
    border-color: rgb(255 255 255 / 40%);
    color: #fff;
  }

  .site-header[data-over-hero='true'] #theme-toggle:hover {
    border-color: #fff;
  }

  .brand {
    font-weight: 700;
    font-size: 1.05rem;
    letter-spacing: -0.01em;
    color: var(--text);
    text-decoration: none;
  }

  nav {
    display: flex;
    gap: 1rem;
    margin-left: auto;
    font-size: 0.9rem;
  }

  nav a {
    color: var(--text-muted);
    text-decoration: none;
    padding: 0.15rem 0;
    border-bottom: 2px solid transparent;
  }

  nav a:hover {
    color: var(--text);
  }

  nav a[aria-current='page'] {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }

  #theme-toggle {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: 50%;
    background: var(--bg-elevated);
    color: var(--text-muted);
    cursor: pointer;
    transition:
      color var(--transition),
      border-color var(--transition);
  }

  #theme-toggle:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  #theme-toggle svg {
    width: 1.05rem;
    height: 1.05rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
  }

  /* 亮色下显示月亮图标，暗色下显示太阳图标 */
  .icon-sun {
    display: none;
  }
  :global(:root[data-theme='dark']) .icon-sun {
    display: block;
  }
  :global(:root[data-theme='dark']) .icon-moon {
    display: none;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .icon-sun {
      display: block;
    }
    :global(:root:not([data-theme='light'])) .icon-moon {
      display: none;
    }
  }
</style>

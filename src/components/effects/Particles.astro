---
// 背景粒子特效
//
// 说明：
// - canvas 不是持久元素，每次导航都会换成新的，所以每次页面载入都重新挂载，
//   并先取消上一个动画帧，避免对已脱离文档的旧 canvas 继续绘制。
// - 尊重系统「减弱动态效果」设置，也避开窄屏（移动端少一个常驻 rAF 循环）。
---

<canvas class="particles" data-particles aria-hidden="true"></canvas>

<script>
  let frame = 0;

  const attach = () => {
    const canvas = document.querySelector<HTMLCanvasElement>('[data-particles]');
    const ctx = canvas?.getContext('2d');
    if (!canvas || !ctx) return;

    cancelAnimationFrame(frame);

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const narrow = window.matchMedia('(max-width: 48rem)').matches;
    if (reduceMotion || narrow) {
      canvas.remove();
      return;
    }

    const theme = getComputedStyle(document.documentElement);
    const dotColor = theme.getPropertyValue('--accent').trim() || '#4c6ef5';
    const lineColor = theme.getPropertyValue('--accent-soft').trim() || dotColor;

    interface Dot {
      x: number;
      y: number;
      vx: number;
      vy: number;
      r: number;
    }

    let dots: Dot[] = [];
    let width = 0;
    let height = 0;

    const build = () => {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      width = canvas.clientWidth;
      height = canvas.clientHeight;
      canvas.width = Math.floor(width * dpr);
      canvas.height = Math.floor(height * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

      const count = Math.min(70, Math.round((width * height) / 24000));
      dots = Array.from({ length: count }, () => ({
        x: Math.random() * width,
        y: Math.random() * height,
        vx: (Math.random() - 0.5) * 0.22,
        vy: (Math.random() - 0.5) * 0.22,
        r: Math.random() * 1.6 + 0.7,
      }));
    };

    const linkDistance = 130;

    const draw = () => {
      if (width !== canvas.clientWidth || height !== canvas.clientHeight) build();

      ctx.clearRect(0, 0, width, height);

      for (const dot of dots) {
        dot.x += dot.vx;
        dot.y += dot.vy;
        if (dot.x < 0 || dot.x > width) dot.vx *= -1;
        if (dot.y < 0 || dot.y > height) dot.vy *= -1;
      }

      ctx.strokeStyle = lineColor;
      ctx.lineWidth = 0.6;
      for (let i = 0; i < dots.length; i++) {
        for (let j = i + 1; j < dots.length; j++) {
          const dx = dots[i].x - dots[j].x;
          const dy = dots[i].y - dots[j].y;
          const dist = Math.hypot(dx, dy);
          if (dist < linkDistance) {
            ctx.globalAlpha = (1 - dist / linkDistance) * 0.35;
            ctx.beginPath();
            ctx.moveTo(dots[i].x, dots[i].y);
            ctx.lineTo(dots[j].x, dots[j].y);
            ctx.stroke();
          }
        }
      }

      ctx.globalAlpha = 0.55;
      ctx.fillStyle = dotColor;
      for (const dot of dots) {
        ctx.beginPath();
        ctx.arc(dot.x, dot.y, dot.r, 0, Math.PI * 2);
        ctx.fill();
      }
      ctx.globalAlpha = 1;

      frame = requestAnimationFrame(draw);
    };

    build();
    frame = requestAnimationFrame(draw);
  };

  attach();
  document.addEventListener('astro:page-load', attach);
</script>

<style>
  .particles {
    position: fixed;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
</style>

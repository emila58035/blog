---
// 音乐播放器（左下角固定 dock）
//
// 跨页不断歌的原理（M3 已在真实 Edge 实测确认，见 PLAN.md 第 5 节）：
//   <ClientRouter /> 交换 body 时会把带 data-astro-transition-persist 的元素
//   原子移动到新文档。持久化必须打在**整个 dock** 上而不是只打在 <audio> 上：
//   只持久 <audio> 的话，按钮和进度条会被新页面的版本替换掉，而这些新节点上
//   没有事件监听（下面的守卫又阻止了重复绑定），控件就会失效。
//   持久整个 dock，DOM 节点与其监听器一起被搬运，状态与交互都不会丢。
//   两个页面的服务端 HTML 都必须渲染出这个元素，因此它放在 BaseLayout 里。
//
// 脚本用 dock.dataset.ready 守卫只初始化一次：导航后脚本会再次执行，
//   而 dock 还是同一个节点，重复绑定会让每次点击触发多次。
import { href } from '../utils/url';
---

<div
  class="player-dock"
  data-player
  data-playlist={href('audio/playlist.json')}
  data-collapsed="false"
  transition:persist="player"
  aria-label="音乐播放器"
>
  <audio data-player-audio preload="metadata"></audio>

  <div class="player-playlist" data-player-panel hidden aria-label="播放列表"></div>

  <div class="player-volume-pop" data-player-volume-pop hidden>
    <input
      class="player-volume-range"
      type="range"
      min="0"
      max="1"
      step="0.01"
      value="1"
      data-player-volume-range
      aria-label="音量大小"
    />
  </div>

  <button class="player-btn" type="button" data-player-toggle aria-label="播放或暂停">
    <svg class="icon-play" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M8 5.14v13.72L19 12z" fill="currentColor"></path>
    </svg>
    <svg class="icon-pause" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M7 5h3.5v14H7zM13.5 5H17v14h-3.5z" fill="currentColor"></path>
    </svg>
  </button>

  <div class="player-body">
    <div class="player-text">
      <span class="player-title" data-player-title>载入中…</span>
      <span class="player-artist" data-player-artist></span>
    </div>
    <div class="player-progress" data-player-progress role="slider" aria-label="播放进度" tabindex="0">
      <div class="player-progress-fill" data-player-fill></div>
    </div>
  </div>

  <div class="player-right">
    <span class="player-time" data-player-time>0:00</span>
    <button class="player-btn player-btn-sm" type="button" data-player-list aria-label="播放列表" aria-expanded="false">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path
          d="M4 6h11M4 12h11M4 18h7M18 13v6.2a1.8 1.8 0 1 1-1.4-1.75V13z"
          fill="none"
          stroke="currentColor"
          stroke-width="1.7"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
    </button>
    <div class="player-volume">
      <button class="player-btn player-btn-sm" type="button" data-player-volume aria-label="音量" aria-expanded="false">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path
            d="M4 9v6h3.2L12 19V5L7.2 9H4zm11.5-1.4a6 6 0 0 1 0 8.8"
            fill="none"
            stroke="currentColor"
            stroke-width="1.7"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </button>
    </div>
    <button class="player-btn player-btn-sm" type="button" data-player-prev aria-label="上一首">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M7 6h2v12H7zM19 6v12l-9-6z" fill="currentColor"></path>
      </svg>
    </button>
    <button class="player-btn player-btn-sm" type="button" data-player-next aria-label="下一首">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M15 6h2v12h-2zM5 6v12l9-6z" fill="currentColor"></path>
      </svg>
    </button>
  </div>
</div>

<script>
  const PLAYER_KEY = 'player.state';
  const audio = document.querySelector<HTMLAudioElement>('[data-player-audio]');
  const dock = document.querySelector<HTMLElement>('[data-player]');

  // 只在首次页面加载初始化；导航后 dock 是同一个持久节点，跳过即可
  if (audio && dock && !dock.dataset.ready) {
    dock.dataset.ready = '1';

    const titleEl = dock.querySelector<HTMLElement>('[data-player-title]')!;
    const artistEl = dock.querySelector<HTMLElement>('[data-player-artist]')!;
    const timeEl = dock.querySelector<HTMLElement>('[data-player-time]')!;
    const fillEl = dock.querySelector<HTMLElement>('[data-player-fill]')!;
    const barEl = dock.querySelector<HTMLElement>('[data-player-progress]')!;
    const toggleBtn = dock.querySelector<HTMLButtonElement>('[data-player-toggle]')!;

    interface SavedState {
      index: number;
      time: number;
      playing: boolean;
      volume?: number;
    }

    const readState = (): SavedState => {
      try {
        const raw = localStorage.getItem(PLAYER_KEY);
        if (raw) {
          const parsed = JSON.parse(raw) as Partial<SavedState>;
          if (typeof parsed.index === 'number') {
            return {
              index: parsed.index,
              time: typeof parsed.time === 'number' ? parsed.time : 0,
              playing: parsed.playing === true,
              volume: typeof parsed.volume === 'number' ? parsed.volume : 1,
            };
          }
        }
      } catch {
        /* 读不到就用默认值 */
      }
      return { index: 0, time: 0, playing: false, volume: 1 };
    };

    const writeState = () => {
      try {
        localStorage.setItem(
          PLAYER_KEY,
          JSON.stringify({
            index: state.index,
            time: audio.currentTime,
            playing: !audio.paused,
            volume: audio.volume,
          })
        );
      } catch {
        /* localStorage 不可用（隐私模式）时忽略 */
      }
    };

    const state = readState();

    const formatTime = (sec: number) => {
      if (!Number.isFinite(sec) || sec < 0) return '0:00';
      const m = Math.floor(sec / 60);
      const s = Math.floor(sec % 60);
      return `${m}:${String(s).padStart(2, '0')}`;
    };

    const apply = (track: Track) => {
      audio.src = resolveSrc(track.src);
      titleEl.textContent = track.title;
      artistEl.textContent = track.artist ?? '';
    };

    const paint = () => {
      const dur = audio.duration;
      const pct = Number.isFinite(dur) && dur > 0 ? (audio.currentTime / dur) * 100 : 0;
      fillEl.style.width = `${pct}%`;
      // 收纳成圆钮时进度环也靠这个变量画（conic-gradient 用角度不用百分比）
      dock.style.setProperty('--player-progress', `${pct * 3.6}deg`);
      timeEl.textContent = formatTime(audio.currentTime);
      toggleBtn.dataset.playing = audio.paused ? 'false' : 'true';
    };

    const play = () => {
      audio.play().catch(() => {
        // 被自动播放策略拦下时不要留一个假的播放态
        toggleBtn.dataset.playing = 'false';
      });
    };

    interface Track {
      title: string;
      artist?: string;
      src: string;
    }

    // 歌单只请求一次；导航后脚本不再重复初始化，所以缓存是安全的
    let tracks: Track[] = [];

    const loadTracks = async (): Promise<Track[]> => {
      if (tracks.length > 0) return tracks;
      const res = await fetch(dock.dataset.playlist!);
      const data = (await res.json()) as { tracks?: Track[] };
      tracks = data.tracks ?? [];
      dock.dataset.count = String(tracks.length);
      buildPanel(tracks); // 面板与歌单同生共死：拿到数据就渲染一次，select 时也有东西可高亮
      return tracks;
    };

    /**
     * 自托管音频写成站内相对路径，第三方直链写成完整 URL。
     * 用 `includes('://')` 区分 —— 委托给 URL 构造函数在这里只会添乱。
     */
    const resolveSrc = (src: string) =>
      src.includes('://') ? src : new URL(src, window.location.origin).href;

    const step = (delta: number) => {
      const count = Number(dock.dataset.count) || 1;
      const next = (((state.index + delta) % count) + count) % count;
      if (audio.src) {
        audio.pause();
        void load(next, 0, true);
      }
    };

    const load = async (index: number, seekTo = 0, autoplay = false) => {
      const list = await loadTracks();
      if (list.length === 0) return;

      state.index = ((index % list.length) + list.length) % list.length;
      apply(list[state.index]);
      syncActive();

      if (seekTo > 0) {
        // 必须在拿到元数据之后才能 seek，否则浏览器会丢弃这次赋值
        await new Promise<void>((resolve) => {
          if (audio.readyState >= 1) return resolve();
          audio.addEventListener('loadedmetadata', () => resolve(), { once: true });
        });
        audio.currentTime = Math.min(seekTo, audio.duration || seekTo);
      }
      if (autoplay) play();
      paint();
    };

    /**
     * 刷新后恢复上次的曲目与进度。autoplay 为 false 时不自动出声 ——
     * 既避开自动播放策略，也避免"只是刷新页面就突然开始放歌"。
     */
    const restore = (index: number, time: number, autoplay: boolean) => load(index, time, autoplay);

    // ---- 歌单面板 ----
    // 面板也是 dock 的子元素，跟 dock 一起被持久化搬运，监听器不会丢。
    // 面板打开本身不影响音频，所以不存在"导航后需要恢复面板"的问题。
    const listBtn = dock.querySelector<HTMLButtonElement>('[data-player-list]')!;
    const panel = dock.querySelector<HTMLElement>('[data-player-panel]')!;
    let panelOpen = false;

    // 当前曲滚入视野。panel 隐藏时 scrollHeight 为 0，直接跳过，别白算 offsetTop。
    const scrollActiveIntoView = () => {
      if (!panelOpen) return;
      const active = panel.querySelector<HTMLElement>('[data-active="true"]');
      if (!active) return;
      const itemTop = active.offsetTop;
      const itemBottom = itemTop + active.offsetHeight;
      if (itemTop < panel.scrollTop) panel.scrollTop = itemTop;
      else if (itemBottom > panel.scrollTop + panel.clientHeight) {
        panel.scrollTop = itemBottom - panel.clientHeight;
      }
    };

    // 每一项都用 innerHTML 生成而不是 createElement：Astro 的 <style> 默认是 scoped，
    // 选择器会带 [data-astro-cid-xxx]，而这个属性只由编译器写进 .astro 模板里渲染出的
    // HTML。用 createElement 造出来的节点没有这个属性，样式会静默失效（普通 build 不报错，
    // 只有肉眼看截图才发现）。innerHTML 生成的节点同样不会带属性，所以这一组选择器
    // 放在了下面的 <style is:global> 里，见文件末尾的说明。
    const escapeHtml = (text: string) =>
      text
        .replaceAll('&', '&amp;')
        .replaceAll('<', '&lt;')
        .replaceAll('>', '&gt;')
        .replaceAll('"', '&quot;');

    const buildPanel = (list: Track[]) => {
      panel.innerHTML = list
        .map(
          (track, index) => `
            <button type="button" class="player-playlist-item" data-index="${index}">
              <span class="player-playlist-index">${index + 1}</span>
              <span class="player-playlist-text">
                <span class="player-playlist-name">${escapeHtml(track.title)}</span>
                <span class="player-playlist-artist">${escapeHtml(track.artist ?? '')}</span>
              </span>
            </button>`
        )
        .join('');
    };

    // 当前曲高亮。面板没打开也照样记状态，下次打开就能滚到正确位置。
    const syncActive = () => {
      panel.querySelectorAll<HTMLElement>('[data-index]').forEach((item) => {
        item.dataset.active = item.dataset.index === String(state.index) ? 'true' : 'false';
      });
      scrollActiveIntoView();
    };

    const setPanel = (open: boolean) => {
      panelOpen = open;
      panel.hidden = !open;
      listBtn.setAttribute('aria-expanded', String(open));
      if (open) {
        // 面板开着就必须是展开态：收起态下右键控件宽度为 0，面板孤零零挂在圆钮上方很怪
        expandDock();
        syncActive();
      } else {
        scheduleCollapse(); // 刚收起，重新开始计时
      }
    };

    listBtn.addEventListener('click', () => setPanel(panel.hidden));
    // 用事件委托而不是给每一项挂监听：面板内容会被 replaceChildren/innerHTML 整体换掉，
    // 挂在 panel 上的委托监听不受重建影响。
    panel.addEventListener('click', (event) => {
      const item = (event.target as HTMLElement).closest<HTMLElement>('[data-index]');
      if (!item) return;
      audio.pause();
      void load(Number(item.dataset.index), 0, true);
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && panelOpen) setPanel(false);
    });
    // 点 dock（面板、列表按钮、播放键、音量、切歌键）以外的地方才收起。
    // 两个坑都在这里：
    //   1. 必须用 composedPath() 而不是 panel.contains(target)：点列表项会触发
    //      load() -> buildPanel() -> replaceChildren()，等事件冒泡到 document 时
    //      被点的按钮已经被摘掉，contains() 返回 false，于是挑一首歌就关一次面板。
    //   2. 判定范围要是整个 dock 而不是"面板 + 列表按钮"：否则点播放键、切歌键
    //      或音量键也会顺手把面板关掉。
    // composedPath() 记录事件派发那一刻的路径，元素已被移除也依然有效。
    document.addEventListener('click', (event) => {
      if (!panelOpen) return;
      if (event.composedPath().includes(dock)) return;
      setPanel(false);
    });

    // ---- 音量 ----
    // 范围输入是 dock 的子元素：切页时随 dock 一起被原子搬运，原生监听器不会丢。
    const volumeBtn = dock.querySelector<HTMLButtonElement>('[data-player-volume]')!;
    const volumePop = dock.querySelector<HTMLElement>('[data-player-volume-pop]')!;
    const volumeRange = dock.querySelector<HTMLInputElement>('[data-player-volume-range]')!;

    // 音量只有这一份真相：改范围输入就等于改音频音量，顺带写回 localStorage。
    // 用属性描述符而不是在 play() 里补一句，是为了让任何赋值路径都不会漏掉。
    let volume = Math.min(Math.max(state.volume ?? 1, 0), 1);
    Object.defineProperty(audio, 'volume', {
      configurable: true,
      get: () => volume,
      set: (next: number) => {
        volume = Math.min(Math.max(next, 0), 1);
        state.volume = volume;
        writeState();
      },
    });
    volumeRange.value = String(volume);

    const setVolume = (next: number) => {
      audio.volume = next;
      volumeRange.value = String(volume);
    };

    volumeBtn.addEventListener('click', () => {
      const open = volumePop.hidden;
      volumePop.hidden = !open;
      volumeBtn.setAttribute('aria-expanded', String(open));
      // 同面板：浮层开着就不能停在收起态
      if (open) expandDock();
      else scheduleCollapse();
    });
    volumeRange.addEventListener('input', () => setVolume(Number(volumeRange.value)));

    toggleBtn.addEventListener('click', () => {
      if (!audio.src) {
        void load(state.index, 0, true);
        return;
      }
      if (audio.paused) play();
      else audio.pause();
    });

    dock.querySelector('[data-player-next]')!.addEventListener('click', () => step(1));
    dock.querySelector('[data-player-prev]')!.addEventListener('click', () => step(-1));

    const seekFromEvent = (event: MouseEvent) => {
      const rect = barEl.getBoundingClientRect();
      const ratio = Math.min(Math.max((event.clientX - rect.left) / rect.width, 0), 1);
      if (Number.isFinite(audio.duration)) audio.currentTime = ratio * audio.duration;
    };
    barEl.addEventListener('click', seekFromEvent);
    barEl.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowRight') audio.currentTime = Math.min(audio.currentTime + 5, audio.duration || 0);
      if (event.key === 'ArrowLeft') audio.currentTime = Math.max(audio.currentTime - 5, 0);
    });

    audio.addEventListener('play', paint);
    audio.addEventListener('pause', () => {
      paint();
      writeState();
    });
    audio.addEventListener('ended', () => step(1));
    audio.addEventListener('timeupdate', () => {
      paint();
      if (Math.floor(audio.currentTime) % 5 === 0) writeState();
    });
    audio.addEventListener('loadedmetadata', paint);
    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'hidden') writeState();
    });

    // ---- 自动收纳成圆钮 ----
    // 只在真的支持悬停的设备上生效：触摸屏没有"移开鼠标"这回事，收起来就点不回去了。
    // 面板或音量浮层开着时不收 —— 否则鼠标一移开就把刚打开的东西收走。
    const COLLAPSE_DELAY = 4000;
    let collapseTimer = 0;
    let pointerInside = false;
    let focusInside = false;

    const canAutoCollapse = () => window.matchMedia('(hover: hover) and (pointer: fine)').matches;
    const busy = () => pointerInside || focusInside || panelOpen || !volumePop.hidden;

    const expandDock = () => {
      window.clearTimeout(collapseTimer);
      dock.dataset.collapsed = 'false';
    };

    const scheduleCollapse = () => {
      window.clearTimeout(collapseTimer);
      if (!canAutoCollapse() || busy()) return;
      collapseTimer = window.setTimeout(() => {
        if (busy()) return;
        dock.dataset.collapsed = 'true';
      }, COLLAPSE_DELAY);
    };

    dock.addEventListener('pointerenter', () => {
      pointerInside = true;
      expandDock();
    });
    dock.addEventListener('pointerleave', () => {
      pointerInside = false;
      scheduleCollapse();
    });
    // 键盘 Tab 进来也要展开，否则焦点落在了摸不到的地方
    dock.addEventListener('focusin', () => {
      focusInside = true;
      expandDock();
    });
    dock.addEventListener('focusout', () => {
      focusInside = false;
      scheduleCollapse();
    });

    void restore(state.index, state.time, state.playing);
    scheduleCollapse();
  }
</script>

<style>
  .player-dock {
    position: fixed;
    left: 1rem;
    bottom: 1rem;
    z-index: 40;
    display: flex;
    align-items: center;
    gap: 0.7rem;
    width: min(23rem, calc(100vw - 2rem));
    padding: 0.55rem 0.7rem;
    border: 1px solid var(--border);
    border-radius: calc(var(--radius) + 4px);
    background: var(--bg-overlay);
    backdrop-filter: blur(14px) saturate(160%);
    box-shadow: 0 6px 24px rgb(0 0 0 / 12%);
    font-size: 0.8rem;
    transition: width var(--transition), height var(--transition), padding var(--transition),
      border-radius var(--transition);
  }

  /* ---- 自动收纳成一个 3.1rem 的圆钮 ----
     注意这里绝不能给 dock 加 overflow: hidden：歌单面板与音量浮层是从 dock
     上沿往上弹的绝对定位子元素，会被一起裁掉。收窄内容的活交给 .player-body /
     .player-right 各自的 width: 0 + overflow: hidden。 */
  .player-dock[data-collapsed='true'] {
    justify-content: center;
    width: 3.1rem;
    height: 3.1rem;
    padding: 0;
    border-radius: 50%;
    /* 必须一起清掉 gap：.player-body / .player-right 收成 0 宽之后，剩下的两道
       0.7rem 间距仍占位，内容比圆钮宽，圆钮里的播放键会被挤到左边去。 */
    gap: 0;
  }

  /* 进度环：白色圆弧套在圆钮边缘。conic-gradient 不认百分比，所以 --player-progress
     由脚本按角度（pct * 3.6deg）写入。 */
  .player-dock[data-collapsed='true']::after {
    content: '';
    position: absolute;
    inset: 0.1rem;
    border-radius: 50%;
    background: conic-gradient(
      #fff 0 var(--player-progress, 0deg),
      rgb(255 255 255 / 35%) var(--player-progress, 0deg) 360deg
    );
    -webkit-mask: radial-gradient(farthest-side, #0000 calc(100% - 0.2rem), #000 calc(100% - 0.19rem));
    mask: radial-gradient(farthest-side, #0000 calc(100% - 0.2rem), #000 calc(100% - 0.19rem));
    pointer-events: none;
  }

  /* 整圆都是播放键的手感 */
  .player-dock[data-collapsed='true'] [data-player-toggle] {
    position: relative;
    width: 100%;
    height: 100%;
    /* 纹路要裁进圆里 */
    overflow: hidden;
  }

  /* 唱片纹路：同心细沟 + 一道偏心高光。纯同心圆是旋转对称的，转起来看不出
     动静，所以必须带一个不对称的高光（或标签）才能读出在转。 */
  .player-dock[data-collapsed='true'] [data-player-toggle]::before {
    content: '';
    position: absolute;
    /* 比按钮大一圈，旋转时四角不会露出空白 */
    inset: -25%;
    border-radius: 50%;
    background:
      /* 偏心的一道高光，压在最上层：同心圆是旋转对称的，没有它就完全看不出在转 */
      linear-gradient(118deg, transparent 40%, rgb(255 255 255 / 26%) 50%, transparent 60%),
      /* 唱片中心那块干净的标签面，播放/暂停图标正好落在上面 */
      radial-gradient(circle at 50% 50%, rgb(255 255 255 / 16%) 0 15px, transparent 15px),
      /* 同心细沟。起手留 3px 空白，否则中心会落下一个 1px 的深色圆点 */
      repeating-radial-gradient(
        circle at 50% 50%,
        transparent 0 3px,
        rgb(0 0 0 / 15%) 3px 4px
      );
    pointer-events: none;
  }

  /* 播放时唱片匀速转，暂停就停在当前角度（animation-play-state 不会归零） */
  @media (prefers-reduced-motion: no-preference) {
    .player-dock[data-collapsed='true'] [data-player-toggle]::before {
      animation: player-spin 6s linear infinite;
      animation-play-state: paused;
    }

    .player-dock[data-collapsed='true'] [data-player-toggle][data-playing='true']::before {
      animation-play-state: running;
    }
  }

  @keyframes player-spin {
    to {
      transform: rotate(360deg);
    }
  }

  .player-dock[data-collapsed='true'] .player-btn:hover {
    transform: none;
  }

  .player-dock[data-collapsed='true'] .player-body,
  .player-dock[data-collapsed='true'] .player-right {
    flex: 0 0 0;
    width: 0;
    overflow: hidden;
    opacity: 0;
    pointer-events: none;
    transition: opacity 60ms ease;
  }

  .player-btn {
    flex: none;
    display: grid;
    place-items: center;
    width: 2.1rem;
    height: 2.1rem;
    padding: 0;
    border: none;
    border-radius: 50%;
    background: var(--accent);
    color: #fff;
    cursor: pointer;
    transition: transform 0.15s ease, opacity 0.15s ease;
  }

  .player-btn:hover {
    transform: scale(1.06);
  }

  .player-btn svg {
    width: 1.05rem;
    height: 1.05rem;
  }

  .player-btn-sm {
    width: 1.5rem;
    height: 1.5rem;
    background: transparent;
    color: var(--text-muted);
  }

  .player-btn-sm svg {
    width: 0.85rem;
    height: 0.85rem;
  }

  .player-btn-sm:hover {
    color: var(--accent);
  }

  .player-playlist {
    position: absolute;
    left: 0.7rem;
    right: 0.7rem;
    bottom: calc(100% + 0.5rem);
    z-index: 1;
    max-height: min(20rem, 60vh);
    padding: 0.25rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-elevated);
    box-shadow: 0 6px 20px rgb(0 0 0 / 14%);
    overflow-y: auto;
    overscroll-behavior: contain;
    transform-origin: bottom center;
    animation: player-panel-in 0.16s ease;
  }

  @keyframes player-panel-in {
    from {
      opacity: 0;
      transform: translateY(0.35rem);
    }
  }

  /* 滚动条在浅底上给一点点存在感，深色主题下不要显得突兀 */
  .player-playlist::-webkit-scrollbar {
    width: 0.5rem;
  }

  .player-playlist::-webkit-scrollbar-thumb {
    border: 2px solid transparent;
    border-radius: 999px;
    background: var(--border);
    background-clip: content-box;
  }

  .player-playlist::-webkit-scrollbar-thumb:hover {
    background: var(--text-muted);
    background-clip: content-box;
  }

  /* 音量：小喇叭 + 向上弹出的竖向滑条 */
  .player-volume {
    display: flex;
  }

  /* 浮层挂在 dock 上而不是喇叭按钮上：喇叭按钮只有 1.5rem 宽，
     而滑条旋转 90° 后「高度 = 原始宽度（7rem）」，以按钮为基准会压住 dock 本体。 */
  .player-volume-pop {
    position: absolute;
    right: 0.7rem;
    bottom: calc(100% + 0.5rem);
    z-index: 2;
    display: grid;
    place-items: center;
    padding: 0.6rem 0.35rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-elevated);
    box-shadow: 0 6px 20px rgb(0 0 0 / 14%);
    /* 收起时必须能穿过点击（input 会从槽里溢出来），展开时才接收事件 */
    pointer-events: none;
    opacity: 0;
    transition: opacity var(--transition);
  }

  .player-dock:has([data-player-volume][aria-expanded='true']) .player-volume-pop {
    pointer-events: auto;
    opacity: 1;
  }

  /* 横向 range 旋转成竖向，这样键盘方向键、拖动、a11y 语义全部保持原生行为 */
  .player-volume-range {
    inline-size: 6rem;
    block-size: 1.25rem;
    margin: 0;
    accent-color: var(--accent);
    cursor: pointer;
    transform: rotate(-90deg);
  }

  /* 播放/暂停图标按状态切换 */
  .player-btn .icon-pause {
    display: none;
  }

  .player-btn[data-playing='true'] .icon-play {
    display: none;
  }

  .player-btn[data-playing='true'] .icon-pause {
    display: block;
  }

  .player-body {
    flex: 1;
    min-width: 0;
    /* 展开时等 dock 先撑开再淡入，不然文字会在窄壳子里闪一下 */
    transition: opacity 80ms ease 100ms;
  }

  .player-text {
    display: flex;
    flex-direction: column;
    line-height: 1.25;
  }

  .player-title {
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    font-weight: 600;
  }

  .player-artist {
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    color: var(--text-muted);
    font-size: 0.72rem;
  }

  .player-progress {
    position: relative;
    height: 0.28rem;
    margin-top: 0.4rem;
    border-radius: 999px;
    background: var(--border);
    cursor: pointer;
  }

  .player-progress-fill {
    height: 100%;
    width: 0;
    border-radius: inherit;
    background: var(--accent);
  }

  .player-progress:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .player-right {
    flex: none;
    display: flex;
    align-items: center;
    gap: 0.1rem;
    transition: opacity 80ms ease 100ms;
  }

  .player-time {
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
    font-size: 0.72rem;
    margin-right: 0.15rem;
  }

  /* 小屏收窄，避免遮挡正文 */
  @media (max-width: 30rem) {
    .player-dock {
      width: calc(100vw - 2rem);
    }

    /* 小屏只留播放键 + 进度条 + 时间，切歌、音量与歌单交给横向滑动手势之外的空间 */
    .player-time,
    .player-volume,
    .player-btn-sm {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .player-dock {
      transition: none;
    }

    .player-body,
    .player-right {
      transition: none;
    }

    .player-btn {
      transition: none;
    }

    .player-btn:hover {
      transform: none;
    }

    .player-playlist {
      animation: none;
    }
  }
</style>

<!--
  歌单项的样式必须是 is:global。

  Astro 的 <style> 默认是 scoped，编译后选择器会带 [data-astro-cid-xxx]，而这个属性
  只有编译器渲染 .astro 模板里的 HTML 时才会写上去。歌单是按运行时数据用 JS 生成的
  （见上面的 buildPanel），造出来的节点没有这个属性，所有 scoped 选择器都不匹配 ——
  普通构建不会报错，面板看上去就是一堆浏览器默认样式的按钮，只有真去看页面才发现。

  同理：以后任何"由 JS 生成节点再套样式"的地方，都要放到这里，或者给元素补上
  [data-astro-cid-xxx]。
-->
<style is:global>
  .player-playlist-item {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    width: 100%;
    padding: 0.35rem 0.5rem;
    border: none;
    border-radius: calc(var(--radius) - 3px);
    background: transparent;
    color: inherit;
    font: inherit;
    font-size: 0.78rem;
    text-align: left;
    cursor: pointer;
  }

  .player-playlist-item:hover {
    background: var(--accent-soft);
  }

  .player-playlist-item[data-active='true'] {
    color: var(--accent);
    background: var(--accent-soft);
  }

  .player-playlist-index {
    flex: none;
    width: 1.6rem;
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
    font-size: 0.72rem;
    text-align: right;
  }

  .player-playlist-item[data-active='true'] .player-playlist-index {
    color: inherit;
  }

  .player-playlist-text {
    display: flex;
    flex-direction: column;
    min-width: 0;
    line-height: 1.3;
  }

  .player-playlist-name {
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .player-playlist-artist {
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    color: var(--text-muted);
    font-size: 0.7rem;
  }

  .player-playlist-item[data-active='true'] .player-playlist-artist {
    color: inherit;
    opacity: 0.75;
  }
</style>

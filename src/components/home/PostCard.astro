---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '../../utils/date';
import { href } from '../../utils/url';

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const { title, description, pubDate, tags, cover, coverAlt } = post.data;
const url = href(`posts/${post.id}/`);
---

<article class="post-card">
  {
    cover && (
      <a class="post-card-cover" href={url} tabindex="-1" aria-hidden="true">
        <Image
          src={cover}
          alt={coverAlt ?? ''}
          widths={[480, 720, 960]}
          sizes="(max-width: 44rem) 100vw, 704px"
        />
      </a>
    )
  }

  <div class="post-card-body">
    <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
    <h2 class="post-card-title"><a href={url}>{title}</a></h2>
    {description && <p class="post-card-desc">{description}</p>}
    {
      tags.length > 0 && (
        <ul class="tags">
          {tags.map((tag) => (
            <li>
              <a href={href(`tags/${encodeURIComponent(tag)}/`)}>{tag}</a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</article>

<style>
  .post-card {
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: calc(var(--radius) + 4px);
    overflow: hidden;
    transition:
      border-color var(--transition),
      box-shadow var(--transition);
  }

  .post-card:hover {
    border-color: color-mix(in srgb, var(--accent) 35%, var(--border));
    box-shadow: 0 8px 24px rgb(0 0 0 / 6%);
  }

  .post-card-cover {
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--code-bg);
  }

  .post-card-cover :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 400ms ease;
  }

  .post-card:hover .post-card-cover :global(img) {
    transform: scale(1.03);
  }

  .post-card-body {
    padding: 1.05rem 1.25rem 1.15rem;
  }

  .post-card-body time {
    display: block;
    font-size: 0.8125rem;
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }

  /* h2 在卡片里，比正文标题低一档 */
  .post-card-title {
    margin: 0.25rem 0 0;
    font-size: 1.15rem;
    line-height: 1.45;
  }

  .post-card-title a {
    color: var(--text);
    text-decoration: none;
  }

  .post-card-title a:hover {
    color: var(--accent);
    text-decoration: underline;
  }

  .post-card-desc {
    margin: 0.35rem 0 0;
    font-size: 0.9rem;
    color: var(--text-muted);
    line-height: 1.7;
  }

  .post-card-body .tags {
    margin-top: 0.7rem;
  }
</style>

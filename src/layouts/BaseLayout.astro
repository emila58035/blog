---
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Player from '../components/Player.astro';
import Particles from '../components/effects/Particles.astro';
import { href } from '../utils/url';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { title, description } = Astro.props;
const siteName = 'Emila 的博客';
const pageTitle = title ? `${title} · ${siteName}` : siteName;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <ClientRouter />
    <link rel="icon" type="image/svg+xml" href={href('favicon.svg')} />
    {description && <meta name="description" content={description} />}
    <title>{pageTitle}</title>
    <script is:inline>
      (() => {
        const saved = localStorage.getItem('theme');
        if (saved === 'light' || saved === 'dark') {
          document.documentElement.dataset.theme = saved;
        }
        // 客户端导航时，新页面的 <html> 在交换那一刻还没有主题属性。
        // 在交换前同步补上，避免每次跳页都闪一下默认主题。
        document.addEventListener('astro:before-swap', (event) => {
          const target = event.newDocument.documentElement;
          const theme = document.documentElement.dataset.theme;
          if (theme) target.dataset.theme = theme;
          // 顶栏高度是量出来的，同样要在交换前带过去，别让 Hero 跳一下
          const headerH = document.documentElement.style.getPropertyValue('--header-h');
          if (headerH) target.style.setProperty('--header-h', headerH);
        });
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">跳到正文</a>
    <Particles />
    <Header />
    <script is:inline>
      // 顶栏高度要参与布局（首页 Hero 会钻到它下面），这里趁 <main> 还没解析
      // 就量出来写进 CSS 变量，避免首帧跳一下。
      const header = document.querySelector('[data-header]');
      if (header) {
        document.documentElement.style.setProperty('--header-h', header.offsetHeight + 'px');
      }
    </script>
    <main id="main">
      <slot />
    </main>
    <Footer />
    <Player />
  </body>
</html>

<style is:global>
  .skip-link {
    position: absolute;
    left: -9999px;
    top: 0;
    z-index: 100;
    padding: 0.5rem 0.9rem;
    background: var(--accent);
    color: #fff;
    border-radius: 0 0 var(--radius) 0;
    text-decoration: none;
  }

  .skip-link:focus {
    left: 0;
  }
</style>

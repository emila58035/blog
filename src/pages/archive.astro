---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { formatDate, sortByDate } from '../utils/date';
import { href } from '../utils/url';

const posts = sortByDate(await getCollection('posts', ({ data }) => !data.draft));

const byYear = new Map<string, typeof posts>();
for (const post of posts) {
  const year = String(post.data.pubDate.getFullYear());
  const bucket = byYear.get(year);
  if (bucket) bucket.push(post);
  else byYear.set(year, [post]);
}
---

<BaseLayout title="归档" description="全部文章，按年份排列。">
  <h1>归档</h1>

  {
    [...byYear].map(([year, yearPosts]) => (
      <section class="year-group">
        <h2>{year}</h2>
        <ul>
          {yearPosts.map((post) => (
            <li>
              <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
              <a href={href(`posts/${post.id}/`)}>{post.data.title}</a>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</BaseLayout>

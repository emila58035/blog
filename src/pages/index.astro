---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import PostCard from '../components/home/PostCard.astro';
import { sortByDate } from '../utils/date';

const posts = sortByDate(await getCollection('posts', ({ data }) => !data.draft));
const SUBTITLE = '记录一些想法，以及折腾过的东西。';
---

<BaseLayout description={SUBTITLE}>
  <Hero title="Emila 的博客" subtitle={SUBTITLE} />

  <div class="post-cards">
    {posts.map((post) => <PostCard post={post} />)}
  </div>
</BaseLayout>

<style>
  /* 每行一列：卡片吃满内容栏宽度 */
  .post-cards {
    display: grid;
    gap: 1.5rem;
  }
</style>
